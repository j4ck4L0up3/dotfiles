{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:26b": {},
        "qwen3.8:27b": {}
      }
    },
    "open-router": {}
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "skill": "allow"
  },
  "agent": {
    "research": {
      "model": "ollama/gemma4:26b",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "websearch_cited": "allow"
      }
    },
    "scaffold": {
      "model": "ollama/gemma4:26b",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "websearch_cited": "allow",
        "bash": "allow",
        "write": "allow"
      }
    },
    "test": {
      "model": "ollama/qwen3.8:27b",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "websearch_cited": "allow",
        "bash": "allow",
        "write": "allow",
        "edit": "allow"
      }
    }
  },
  "plugin": ["opencode-websearch-cited"]
}
