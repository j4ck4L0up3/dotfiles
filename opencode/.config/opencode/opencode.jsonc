{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "providers": {
    "ollama": {
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:26b": {},
        "qwen3.8:27b": {}
      }
    },
    "open-router": {}
  },
  "permissions": [
    { "action": "read", "resource": "$HOME/*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "grep", "resource": "$HOME/*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "$HOME/*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "ask" }
  ],
  "policies": [{ "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" }],
  "agents": {
    "research": {
      "model": "ollama/gemma4:26b"
    },
    "scaffold": {
      "model": "ollama/gemma4:26b",
      "permissions": [
        { "action": "edit", "resource": "$HOME/*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    },
    "test": {
      "model": "ollama/qwen3.8:27b",
      "permissions": [
        { "action": "edit", "resource": "$HOME/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "plugins": [
    "opencode-websearch-cited"
  ]
}
