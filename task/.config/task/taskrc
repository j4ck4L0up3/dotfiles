# Task location
data.location=$XDG_CONFIG_HOME/task/.task

# Format dates
dateformat=M-D-Y
dateformat.report=A, B d, Y h:n

# Load theme
include ~/.config/task/kitty-dracula.theme

# Suppress TASKRC override message
verbose=blank,header,footnote,label,new-id,affected,edit,special,project,sync,unwait

# Reports
report.all.sort=due+

report.scheduled.description=Scheduled tasks
report.scheduled.columns=id,scheduled.relative,due.relative,project,tags,description
report.scheduled.sort=scheduled+
report.scheduled.filter=+SCHEDULED
